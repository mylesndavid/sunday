<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sunday's renderer captures mic for voice + Hey Sunday wake word. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Network access for the daemon WebSocket + HTTPS. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Electron requires these on hardened runtime to JIT-compile JS. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- The bundled Python daemon (PyInstaller) loads its own dylibs that
         aren't signed by our team; hardened runtime would block them without
         this. Required for the embedded brain to start. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Read user-chosen files for drag-and-drop attachments. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>

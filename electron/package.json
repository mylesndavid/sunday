{
  "name": "sunday-desktop",
  "productName": "Sunday",
  "version": "0.4.85",
  "description": "Sunday — a personal AI that knows you.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:mac:dmg": "electron-builder --mac dmg",
    "dist:mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --config.mac.identity=null",
    "dist:mac:signed": "node build/ensure-secrets.js && electron-builder --mac --arm64"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "com.sunday.desktop",
    "productName": "Sunday",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-capture.js",
      "preload-meeting.js",
      "preload-wake.js",
      "satellite.js",
      "renderer/**/*",
      "overlay/**/*",
      "build/entitlements.mac.plist",
      "build/icon.icns"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Sunday uses the microphone for voice input, the \"Hey Sunday\" wake word, the ambient observer, and meeting recording. Audio is transcribed on-device.",
        "NSCameraUsageDescription": "Sunday does not use the camera.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "identity": "Myles Iyabor-David (6PG9CR3SRN)",
      "notarize": {
        "teamId": "6PG9CR3SRN"
      },
      "icon": "build/icon.icns"
    },
    "afterSign": "build/notarize.js",
    "publish": {
      "provider": "github",
      "owner": "mylesndavid",
      "repo": "sunday"
    },
    "dmg": {
      "title": "Sunday ${version}",
      "writeUpdateInfo": true,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "extraResources": [
      {
        "from": "build/notch-metrics",
        "to": "notch-metrics"
      },
      {
        "from": "build/NotchHUD.app",
        "to": "NotchHUD.app"
      },
      {
        "from": "build/observer.py",
        "to": "observer.py"
      },
      {
        "from": "build/daemon-dist/sunday-daemon",
        "to": "sunday-daemon"
      },
      {
        "from": "build/argus",
        "to": "argus"
      },
      {
        "from": "../extension",
        "to": "extension"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}

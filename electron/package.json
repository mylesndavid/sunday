{
  "name": "sunday-desktop",
  "productName": "Sunday",
  "version": "0.0.54",
  "description": "Sunday \u2014 a personal AI that knows you.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:mac:dmg": "electron-builder --mac dmg",
    "dist:mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --config.mac.identity=null"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "com.sunday.desktop",
    "productName": "Sunday",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-capture.js",
      "satellite.js",
      "renderer/**/*",
      "overlay/**/*",
      "build/entitlements.mac.plist",
      "build/icon.icns"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Sunday uses the microphone for the one-shot mic button in chat. There is no always-on listener.",
        "NSCameraUsageDescription": "Sunday does not use the camera.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "notarize": false,
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Sunday ${version}",
      "writeUpdateInfo": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "extraResources": [
      {
        "from": "build/notch-metrics",
        "to": "notch-metrics"
      },
      {
        "from": "build/NotchHUD.app",
        "to": "NotchHUD.app"
      },
      {
        "from": "build/observer.py",
        "to": "observer.py"
      }
    ]
  }
}

# Sunday credentials. Copy this file to ~/.sunday/credentials.env and fill in
# the values you have. Sunday boots without any of these — she'll just refuse
# the tools whose credentials are missing (with a clear error explaining what
# to set).
#
# Equivalent CLI: `sunday credential set <NAME> <VALUE>`.
# Env vars with the same names also win at runtime.

# ─── Brain (LLM) — pick ONE ───────────────────────────────────────────────

# Recommended: OpenRouter — single gateway, swap models by changing
# config.model.name (e.g. deepseek/deepseek-chat, anthropic/claude-3.7-sonnet,
# openai/gpt-4o-mini, etc.). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional fallbacks. Sunday's `runtime_choice` config decides which to use;
# the default 'auto' prefers OpenRouter.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ─── Hermes runtime (optional) ────────────────────────────────────────────
# If you want Sunday to drive an installed `hermes` CLI as the runtime
# instead of native OpenAI streaming. Install Hermes separately; these
# values mirror Hermes's own --provider / --model flags.
HERMES_API_KEY=
HERMES_BASE_URL=
HERMES_CLI_PROVIDER=openrouter
HERMES_CLI_MODEL=deepseek/deepseek-chat
HERMES_CLI_MAX_TURNS=1
HERMES_MODE=cli

# ─── iMessage via Sendblue (optional) ─────────────────────────────────────
# Lets people text Sunday at a dedicated Sendblue-provisioned number.
# Provision a number + grab keys at https://sendblue.co
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=

# ─── Outbound phone calls via VAPI (optional) ─────────────────────────────
# Sunday can pick up the phone on your behalf. https://vapi.ai
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=

# ─── Cloudflare Browser Rendering + Sandboxes (optional) ──────────────────
# Browser Rendering: navigate, screenshot, scrape via Cloudflare's headless
# Chrome. Account ID is at the right side of the CF dashboard. API token
# needs "Browser Rendering: Edit" permission.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Code sandbox: optional URL of a Cloudflare Worker you've deployed that
# wraps a Sandbox runtime. See examples/sandbox-worker/ (not yet bundled).
SANDBOX_WORKER_URL=

# ─── Research (optional, future) ──────────────────────────────────────────
PERPLEXITY_API_KEY=

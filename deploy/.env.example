# Copy to .env and fill in. `docker compose up -d` reads this.

# ── Sunday ──
OPENROUTER_API_KEY=
OPENAI_API_KEY=
SUNDAY_PORT=8765

# ── Nango (integrations) ──
# 32-byte base64 key — generate with: openssl rand -base64 32
NANGO_ENCRYPTION_KEY=
# Public HTTPS URL your reverse proxy maps to nango-server:3003 — OAuth
# providers redirect here. e.g. https://nango.example.com
NANGO_PUBLIC_URL=https://nango.example.com
# Dashboard login (used once to grab the secret key + add provider apps).
NANGO_DASHBOARD_USERNAME=admin
NANGO_DASHBOARD_PASSWORD=change-me
# After Nango is up: paste the environment secret key from the dashboard.
NANGO_SECRET_KEY=
NANGO_CONNECTION_ID=sunday

# Copy to .env and fill in. `docker compose up -d` reads this.

# ── Sunday ──
OPENROUTER_API_KEY=
OPENAI_API_KEY=
SUNDAY_PORT=8765

# ── Nango (integrations) ──
# 32-byte base64 key — generate with: openssl rand -base64 32
NANGO_ENCRYPTION_KEY=
# Public HTTPS URL your reverse proxy maps to nango-server:3003 — OAuth
# providers redirect here. e.g. https://nango.example.com
NANGO_PUBLIC_URL=https://nango.example.com
# Public HTTPS URL mapping to the Connect UI (nango-server:3009) — where
# the user approves the connection. e.g. https://connect.example.com
NANGO_CONNECT_URL=https://connect.example.com
# Dashboard login (used once to grab the secret key + add provider apps).
NANGO_DASHBOARD_USERNAME=admin
NANGO_DASHBOARD_PASSWORD=change-me
# After Nango is up: the environment secret + public key (Settings in the
# Nango dashboard, or query _nango_environments).
NANGO_SECRET_KEY=
NANGO_PUBLIC_KEY=
NANGO_CONNECTION_ID=sunday

# ── OAuth client creds (declarative integration setup) ──
# Create the OAuth client once in each provider's console, then set it here.
# On startup Sunday provisions the matching Nango integration automatically —
# no dashboard clicking. Google client covers both Gmail + Calendar.
# Authorized redirect URI in Google Cloud: <NANGO_PUBLIC_URL>/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
